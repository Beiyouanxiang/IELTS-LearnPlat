# ---- 基础 ----
PORT=3007
NODE_ENV=development
# 生产环境必须是 >=32 字节的随机串，生成命令：openssl rand -hex 32
JWT_SECRET=dev-secret-change-me

# ---- 数据库 ----
# 相对 server/ 目录；生产建议放到 data/ 并 chmod 600
DB_PATH=./data/ielts.db

# ---- 前端来源（CORS 白名单，逗号分隔）----
CORS_ORIGINS=http://localhost:5180

# ---- LLM provider（与 Bookmark-Page 保持一致，三选一/可切换）----
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-4-flash

MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-8k

# ---- 注册开关 ----
# true = 必须持邀请码才能注册（首版：只给我和朋友用）
INVITE_ONLY=true
# 生产环境首次管理员注册需使用该文件中的随机初始化邀请码
OWNER_BOOTSTRAP_FILE=./owner-bootstrap-code
